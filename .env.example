# ==========================================
# OpenContest Environment Configuration
# ==========================================

# Port mappings for host machine
FRONTEND_PORT=5173
BACKEND_PORT=8000
RABBITMQ_UI_PORT=15672

# Database configuration
POSTGRES_DB=opencontest
POSTGRES_USER=opencontest
POSTGRES_PASSWORD=opencontest

# Number of runner instances (workers) to run in parallel
# Change this number to run multiple runners simultaneously!
RUNNERS_COUNT=1

# Security token between runners and backend
RUNNER_CALLBACK_TOKEN=dev-runner-token
